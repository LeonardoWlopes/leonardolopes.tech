{
	"cSpell.words": ["testid", "oklch", "shadcn", "lefthook", "commitlint"],
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "biomejs.biome",
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit"
	},
	"editor.detectIndentation": false,
	"editor.guides.bracketPairs": "active",
	"editor.linkedEditing": true,
	"editor.tabSize": 4,
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		".editorconfig": "biome.*, lefthook*, commitlint*, components.json",
		".env": ".env*",
		".gitignore": ".git*",
		"package.json": "tsconfig*, pnpm*, .nvmrc, .releaserc, next*, vitest*",
		"README.md": "CHANGELOG*, CLAUDE.md"
	},
	"tailwindCSS.experimental.classRegex": [
		["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
		["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
	],
	"coverage-gutters.coverageFileNames": ["clover.xml"],
	"typescript.tsdk": "node_modules/typescript/lib"
}
