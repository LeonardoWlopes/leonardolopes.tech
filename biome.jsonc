{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.mjs",
			"**/*.mts",
			"**/*.json",
			"!!**/.next",
			"!!**/node_modules",
			"!!**/coverage",
			"!!**/temp",
			"!!.claude",
			"!!skills-lock.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "warn",
				"useExhaustiveDependencies": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"react": {
								"importNames": ["*"],
								"message": "Use named imports instead of `import * as React from 'react'`."
							}
						}
					}
				},
				"useImportType": "on"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConfusingVoidType": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"quoteStyle": "single"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		// Vendored WebGL scenes: `gl.useProgram()` is a WebGL call, not a React hook,
		// but its `use` prefix trips useHookAtTopLevel
		{
			"includes": [
				"src/components/ui/laser-flow/**",
				"src/components/ui/floating-lines/**",
				"src/components/ui/ghost-fibers/**",
				"src/components/ui/lightfall/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"useHookAtTopLevel": "off"
					}
				}
			}
		}
	]
}
